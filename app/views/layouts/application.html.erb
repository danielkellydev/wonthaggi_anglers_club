<!DOCTYPE html>
<html class="scroll-smooth">
  <head>
    <title><%= content_for(:title) || "Wonthaggi Angling Club" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-offwhite text-charcoal min-h-screen flex flex-col">
    <% is_homepage = controller_name == "pages" && action_name == "home" %>

    <%# ── Smart Navbar ── %>
    <nav class="fixed top-0 left-0 right-0 z-50 text-white transition-all duration-300 <%= 'bg-navy-950/95 backdrop-blur-sm' unless is_homepage %>"
         data-controller="navbar"
         data-navbar-homepage-value="<%= is_homepage %>">

<%# Large hero logo (homepage only, pinned top-left of viewport) — desktop/tablet only %>
      <% if is_homepage %>
        <a href="/" class="hidden sm:block sm:fixed sm:top-8 sm:left-8 z-10 transition-all duration-300" data-navbar-target="heroLogo">
          <img src="/WAClogo-white.png" alt="" aria-hidden="true" class="sm:h-32 sm:w-32 lg:h-36 lg:w-36 drop-shadow-lg">
        </a>
      <% end %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20 lg:h-24">
          <%# Logo + club name (visible when scrolled / non-homepage) %>
          <a href="/" class="flex items-center gap-4 group transition-all duration-300 <%= is_homepage ? 'opacity-0 pointer-events-none' : '' %>" data-navbar-target="compactLogo">
            <img src="/WAClogo-white.png" alt="" class="h-12 w-12 drop-shadow-lg" aria-hidden="true">
            <span class="text-xl font-bold tracking-wide group-hover:text-sand-400 transition-colors hidden sm:inline">Wonthaggi Angling Club</span>
          </a>

          <%# Desktop nav links %>
          <div class="hidden md:flex items-center gap-8">
            <%= link_to "News", posts_path, class: "text-base lg:text-lg font-bold uppercase tracking-widest text-white/70 hover:text-white hover:scale-110 transition-all duration-200 origin-center" %>
            <%= link_to "Events", events_path, class: "text-base lg:text-lg font-bold uppercase tracking-widest text-white/70 hover:text-white hover:scale-110 transition-all duration-200 origin-center" %>
            <%= link_to "Gallery", gallery_path, class: "text-base lg:text-lg font-bold uppercase tracking-widest text-white/70 hover:text-white hover:scale-110 transition-all duration-200 origin-center" %>
            <%# Club dropdown %>
            <div class="relative" data-controller="dropdown" data-action="mouseenter->dropdown#show mouseleave->dropdown#hide">
              <button data-action="click->dropdown#toggle" class="text-base lg:text-lg font-bold uppercase tracking-widest text-white/70 hover:text-white hover:scale-110 transition-all duration-200 origin-center inline-flex items-center gap-1 cursor-pointer">
                Club
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </button>
              <div data-dropdown-target="menu" class="hidden absolute right-0 top-full w-48 pt-2 z-50">
                <div class="rounded-xl bg-navy-950/95 backdrop-blur-sm border border-white/10 shadow-xl overflow-hidden">
                  <%= link_to "About", about_path, class: "block px-4 py-3 text-sm font-semibold text-white/70 hover:text-white hover:bg-white/10 transition-colors" %>
                  <%= link_to "Fish Points", fish_points_path, class: "block px-4 py-3 text-sm font-semibold text-white/70 hover:text-white hover:bg-white/10 transition-colors" %>
                  <%= link_to "Membership", membership_path, class: "block px-4 py-3 text-sm font-semibold text-white/70 hover:text-white hover:bg-white/10 transition-colors" %>
                  <%= link_to "Sponsors", sponsors_path, class: "block px-4 py-3 text-sm font-semibold text-white/70 hover:text-white hover:bg-white/10 transition-colors" %>
                </div>
              </div>
            </div>
          </div>

          <%# Mobile hamburger %>
          <button type="button"
                  class="md:hidden inline-flex items-center justify-center p-2 rounded-md hover:bg-white/10 transition-colors min-h-[48px] min-w-[48px]"
                  data-action="click->navbar#toggle"
                  aria-controls="mobile-menu"
                  aria-label="Toggle navigation menu">
            <svg data-navbar-target="openIcon" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
            <svg data-navbar-target="closeIcon" class="hidden h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <%# Mobile menu dropdown %>
      <div id="mobile-menu" class="hidden md:hidden border-t border-white/10 bg-navy-950/95 backdrop-blur-sm" data-navbar-target="menu">
        <div class="px-6 pt-4 pb-6 space-y-1">
          <%= link_to "News", posts_path, data: { action: "click->navbar#closeMenu" }, class: "block px-3 py-3 text-lg font-bold uppercase tracking-widest text-white/70 hover:text-white transition-colors" %>
          <%= link_to "Events", events_path, data: { action: "click->navbar#closeMenu" }, class: "block px-3 py-3 text-lg font-bold uppercase tracking-widest text-white/70 hover:text-white transition-colors" %>
          <%= link_to "Gallery", gallery_path, data: { action: "click->navbar#closeMenu" }, class: "block px-3 py-3 text-lg font-bold uppercase tracking-widest text-white/70 hover:text-white transition-colors" %>
          <%= link_to "About", about_path, data: { action: "click->navbar#closeMenu" }, class: "block px-3 py-3 text-lg font-bold uppercase tracking-widest text-white/70 hover:text-white transition-colors" %>
          <%= link_to "Fish Points", fish_points_path, data: { action: "click->navbar#closeMenu" }, class: "block px-3 py-3 text-lg font-bold uppercase tracking-widest text-white/70 hover:text-white transition-colors" %>
          <%= link_to "Sponsors", sponsors_path, data: { action: "click->navbar#closeMenu" }, class: "block px-3 py-3 text-lg font-bold uppercase tracking-widest text-white/70 hover:text-white transition-colors" %>
          <%= link_to "Join Us", membership_path, data: { action: "click->navbar#closeMenu" }, class: "block px-3 py-3 text-lg font-bold uppercase tracking-widest text-sand-400 hover:text-sand-300 transition-colors" %>
        </div>
      </div>
    </nav>

    <%# Spacer — not needed on homepage since hero goes under the navbar %>
    <% unless is_homepage %>
      <div class="h-20 lg:h-24"></div>
    <% end %>

    <main class="flex-1">
      <% if notice = flash[:notice] %>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
          <p class="py-2 px-4 bg-green-50 text-green-700 rounded-lg text-sm font-medium"><%= notice %></p>
        </div>
      <% end %>
      <% if alert = flash[:alert] %>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
          <p class="py-2 px-4 bg-red-50 text-red-600 rounded-lg text-sm font-medium"><%= alert %></p>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <%# ── Footer ── %>
    <footer class="bg-navy-950 text-navy-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <%# About + Social %>
          <div>
            <img src="/WAClogo-white.png" alt="Wonthaggi Angling Club" class="h-20 w-20 mb-4">
            <h3 class="text-white text-lg font-bold mb-3">Wonthaggi Angling Club</h3>
            <p class="text-sm leading-relaxed mb-4">
              Bringing together fishing enthusiasts across the Bass Coast region. From weekend comps to community events, we're all about great fishing and good mates.
            </p>
          </div>

          <%# Quick Links %>
          <div>
            <h3 class="text-white text-lg font-bold mb-3">Quick Links</h3>
            <ul class="space-y-2 text-sm">
              <li><%= link_to "Home", root_path, class: "hover:text-sand-400 transition-colors" %></li>
              <li><%= link_to "News", posts_path, class: "hover:text-sand-400 transition-colors" %></li>
              <li><%= link_to "Events", events_path, class: "hover:text-sand-400 transition-colors" %></li>
              <li><%= link_to "Gallery", gallery_path, class: "hover:text-sand-400 transition-colors" %></li>
              <li><%= link_to "About", about_path, class: "hover:text-sand-400 transition-colors" %></li>
              <li><%= link_to "Fish Points", fish_points_path, class: "hover:text-sand-400 transition-colors" %></li>
              <li><%= link_to "Become a Member", membership_path, class: "hover:text-sand-400 transition-colors" %></li>
            </ul>
          </div>

          <%# Contact Info %>
          <div>
            <h3 class="text-white text-lg font-bold mb-3">Contact</h3>
            <ul class="space-y-3 text-sm">
              <li class="flex items-start space-x-2">
                <svg class="h-5 w-5 mt-0.5 shrink-0 text-sand-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
                <span>Wonthaggi, Victoria, Australia</span>
              </li>
              <li class="flex items-start space-x-2">
                <svg class="h-5 w-5 mt-0.5 shrink-0 text-sand-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
                <%= link_to "Contact Us", membership_path(anchor: "committee"), class: "hover:text-sand-400 transition-colors" %>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <%# Bottom bar %>
      <div class="border-t border-navy-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-center gap-4 text-sm text-navy-400">
          <span>&copy; <%= Date.today.year %> Wonthaggi Angling Club. All rights reserved.</span>
          <%= link_to "Admin", new_session_path, class: "hover:text-sand-400 transition-colors" %>
        </div>
      </div>
    </footer>
  </body>
</html>
