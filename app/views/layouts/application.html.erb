<!DOCTYPE html>
<html class="scroll-smooth">
  <head>
    <title><%= content_for(:title) || "Wonthaggi Angling Club" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-offwhite text-charcoal min-h-screen flex flex-col">
    <%# ── Sticky Navigation ── %>
    <nav class="sticky top-0 z-50 bg-gradient-to-r from-navy-900 to-ocean-800 text-white shadow-lg" data-controller="navbar">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <%# Logo / Club name %>
          <a href="/" class="text-xl font-bold tracking-wide hover:text-sand-400 transition-colors">
            Wonthaggi Angling Club
          </a>

          <%# Desktop nav links %>
          <div class="hidden md:flex items-center space-x-1">
            <%= link_to "Home", root_path, class: "px-3 py-2 rounded-md text-sm font-medium hover:bg-white/10 transition-colors" %>
            <%= link_to "News", posts_path, class: "px-3 py-2 rounded-md text-sm font-medium hover:bg-white/10 transition-colors" %>
            <%= link_to "Events", events_path, class: "px-3 py-2 rounded-md text-sm font-medium hover:bg-white/10 transition-colors" %>
            <%= link_to "Gallery", gallery_path, class: "px-3 py-2 rounded-md text-sm font-medium hover:bg-white/10 transition-colors" %>
            <a href="#membership" class="ml-4 inline-flex items-center px-4 py-2 rounded-md text-sm font-semibold bg-sand-400 text-navy-950 hover:bg-sand-300 transition-colors shadow-md">
              Join Us
            </a>
          </div>

          <%# Mobile hamburger button %>
          <button type="button"
                  class="md:hidden inline-flex items-center justify-center p-2 rounded-md hover:bg-white/10 transition-colors min-h-[48px] min-w-[48px]"
                  data-navbar-toggle
                  data-action="click->navbar#toggle"
                  aria-controls="mobile-menu"
                  aria-expanded="false"
                  aria-label="Toggle navigation menu">
            <%# Hamburger icon %>
            <svg data-navbar-target="openIcon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
            <%# Close (X) icon %>
            <svg data-navbar-target="closeIcon" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <%# Mobile menu dropdown %>
      <div id="mobile-menu" class="hidden md:hidden border-t border-white/10" data-navbar-target="menu">
        <div class="px-4 pt-2 pb-4 space-y-1">
          <%= link_to "Home", root_path, data: { action: "click->navbar#closeMenu" }, class: "block px-3 py-3 rounded-md text-base font-medium hover:bg-white/10 transition-colors min-h-[48px] flex items-center" %>
          <%= link_to "News", posts_path, data: { action: "click->navbar#closeMenu" }, class: "block px-3 py-3 rounded-md text-base font-medium hover:bg-white/10 transition-colors min-h-[48px] flex items-center" %>
          <%= link_to "Events", events_path, data: { action: "click->navbar#closeMenu" }, class: "block px-3 py-3 rounded-md text-base font-medium hover:bg-white/10 transition-colors min-h-[48px] flex items-center" %>
          <%= link_to "Gallery", gallery_path, data: { action: "click->navbar#closeMenu" }, class: "block px-3 py-3 rounded-md text-base font-medium hover:bg-white/10 transition-colors min-h-[48px] flex items-center" %>
          <a href="#membership" data-action="click->navbar#closeMenu" class="block mt-2 px-3 py-3 rounded-md text-base font-semibold bg-sand-400 text-navy-950 hover:bg-sand-300 transition-colors text-center min-h-[48px] flex items-center justify-center">
            Join Us
          </a>
        </div>
      </div>
    </nav>

    <main class="flex-1">
      <% if notice = flash[:notice] %>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
          <p class="py-2 px-4 bg-green-50 text-green-700 rounded-lg text-sm font-medium"><%= notice %></p>
        </div>
      <% end %>
      <% if alert = flash[:alert] %>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
          <p class="py-2 px-4 bg-red-50 text-red-600 rounded-lg text-sm font-medium"><%= alert %></p>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <%# ── Footer ── %>
    <footer class="bg-navy-950 text-navy-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <%# About + Social %>
          <div>
            <h3 class="text-white text-lg font-bold mb-3">Wonthaggi Angling Club</h3>
            <p class="text-sm leading-relaxed mb-4">
              Bringing together fishing enthusiasts across the Bass Coast region. From weekend comps to community events, we're all about great fishing and good mates.
            </p>
            <div class="flex space-x-4">
              <%# Facebook %>
              <a href="#" class="text-navy-300 hover:text-sand-400 transition-colors" aria-label="Facebook">
                <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </a>
              <%# Instagram %>
              <a href="#" class="text-navy-300 hover:text-sand-400 transition-colors" aria-label="Instagram">
                <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                </svg>
              </a>
            </div>
          </div>

          <%# Quick Links %>
          <div>
            <h3 class="text-white text-lg font-bold mb-3">Quick Links</h3>
            <ul class="space-y-2 text-sm">
              <li><%= link_to "Home", root_path, class: "hover:text-sand-400 transition-colors" %></li>
              <li><%= link_to "News", posts_path, class: "hover:text-sand-400 transition-colors" %></li>
              <li><%= link_to "Events", events_path, class: "hover:text-sand-400 transition-colors" %></li>
              <li><%= link_to "Gallery", gallery_path, class: "hover:text-sand-400 transition-colors" %></li>
              <li><a href="#membership" class="hover:text-sand-400 transition-colors">Become a Member</a></li>
            </ul>
          </div>

          <%# Contact Info %>
          <div>
            <h3 class="text-white text-lg font-bold mb-3">Contact</h3>
            <ul class="space-y-3 text-sm">
              <li class="flex items-start space-x-2">
                <svg class="h-5 w-5 mt-0.5 shrink-0 text-sand-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
                <span>Wonthaggi, Victoria, Australia</span>
              </li>
              <li class="flex items-start space-x-2">
                <svg class="h-5 w-5 mt-0.5 shrink-0 text-sand-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
                <a href="mailto:info@wonthaggiangling.com.au" class="hover:text-sand-400 transition-colors">info@wonthaggiangling.com.au</a>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <%# Bottom bar %>
      <div class="border-t border-navy-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-center gap-4 text-sm text-navy-400">
          <span>&copy; <%= Date.today.year %> Wonthaggi Angling Club. All rights reserved.</span>
          <%= link_to "Admin", new_session_path, class: "hover:text-sand-400 transition-colors" %>
        </div>
      </div>
    </footer>
  </body>
</html>
