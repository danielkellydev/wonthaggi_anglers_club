<section class="py-16 sm:py-20 bg-offwhite">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <% if @event.featured_image.attached? %>
      <%= image_tag @event.featured_image.variant(resize_to_limit: [1200, 800]), class: "w-full rounded-xl shadow-md mb-8" %>
    <% end %>

    <h1 class="text-3xl sm:text-4xl font-bold text-charcoal mb-6"><%= @event.title %></h1>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
        <div>
          <p class="text-gray-500 mb-1">Date & Time</p>
          <p class="font-medium text-charcoal">
            <%= @event.starts_at.strftime("%A, %-d %B %Y at %l:%M %p").strip %>
            <% if @event.ends_at.present? %>
              <br><span class="text-gray-500">to</span> <%= @event.ends_at.strftime("%l:%M %p").strip %>
            <% end %>
          </p>
        </div>
        <% if @event.location.present? %>
          <div>
            <p class="text-gray-500 mb-1">Location</p>
            <p class="font-medium text-charcoal"><%= @event.location %></p>
          </div>
        <% end %>
      </div>
    </div>

    <% if @event.description.present? %>
      <div class="prose prose-lg max-w-none text-charcoal">
        <%= @event.description %>
      </div>
    <% end %>

    <div class="mt-12 pt-8 border-t border-gray-200">
      <%= link_to "&larr; Back to Events".html_safe, events_path, class: "text-sm font-semibold text-ocean-700 hover:text-ocean-600 transition-colors" %>
    </div>
  </div>
</section>
