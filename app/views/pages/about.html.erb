<% content_for :title, "About" %>
<% content_for :description, "Wonthaggi Angling Club is a community of passionate anglers in the Bass Coast region. Monthly competitions, social events, and a welcoming clubroom on Korumburra Road, Wonthaggi." %>
<% content_for :head do %>
  <%= render "shared/structured_data" %>
<% end %>

<%# ══════════════════════════════════════════════════════════════
     Section 1 — About the Club
     ══════════════════════════════════════════════════════════════ %>
<section class="py-16 sm:py-20 bg-offwhite">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-charcoal">About the Club</h2>
      <div class="mt-3 mx-auto w-16 h-1 rounded-full bg-sand-400"></div>
    </div>

    <div class="bg-white rounded-xl shadow-md p-8 text-base text-gray-700 leading-relaxed space-y-4">
      <p>Founded in <strong class="text-charcoal">1982</strong>, Wonthaggi Angling Club is a community of passionate anglers based in the heart of the Bass Coast region. Whether you're a weekend warrior chasing flathead or a seasoned pro targeting snapper, there's a place for you here.</p>
      <p>We encourage family participation and welcome anyone with an interest in fishing — from experienced anglers to beginners wanting to learn more about the sport. We run regular competitions, social events, and provide a welcoming clubroom for members to gather, share stories, and enjoy great company.</p>
    </div>
  </div>
</section>

<%# ══════════════════════════════════════════════════════════════
     Section 2 — Clubrooms
     ══════════════════════════════════════════════════════════════ %>
<section class="py-16 sm:py-20 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-charcoal">Clubrooms</h2>
      <div class="mt-3 mx-auto w-16 h-1 rounded-full bg-sand-400"></div>
    </div>

    <div class="bg-offwhite rounded-xl p-8 space-y-4">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-lg bg-ocean-100 flex items-center justify-center shrink-0 mt-1">
          <svg class="h-5 w-5 text-ocean-700" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-charcoal text-lg">Location</h3>
          <p class="text-base text-gray-700">Korumburra Road, Wonthaggi (near the main grandstand at the recreation reserve).</p>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-lg bg-ocean-100 flex items-center justify-center shrink-0 mt-1">
          <svg class="h-5 w-5 text-ocean-700" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8.25v-1.5m0 1.5c-1.355 0-2.697.056-4.024.166C6.845 8.51 6 9.473 6 10.608v2.513m6-4.871c1.355 0 2.697.056 4.024.166C17.155 8.51 18 9.473 18 10.608v2.513M15 8.25v-1.5m-6 1.5v-1.5m12 9.75l-1.5.75a3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0L3 16.5m15-3.379a48.474 48.474 0 00-6-.371c-2.032 0-4.034.126-6 .371m12 0c.39.049.777.102 1.163.16 1.07.16 1.837 1.094 1.837 2.175v5.169c0 .621-.504 1.125-1.125 1.125H4.125A1.125 1.125 0 013 20.625v-5.17c0-1.08.768-2.014 1.837-2.174A47.78 47.78 0 016 13.12M12.265 3.11a.375.375 0 11-.53 0L12 2.845l.265.265zm-3 0a.375.375 0 11-.53 0L9 2.845l.265.265zm6 0a.375.375 0 11-.53 0L15 2.845l.265.265z" />
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-charcoal text-lg">Facilities</h3>
          <p class="text-base text-gray-700">Licensed premises with all refreshments available at reasonable prices. EFTPOS available. Dinner and snacks provided at weigh in on competition days.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ══════════════════════════════════════════════════════════════
     Section 3 — Competitions
     ══════════════════════════════════════════════════════════════ %>
<section class="py-16 sm:py-20 bg-offwhite">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-charcoal">Competitions</h2>
      <div class="mt-3 mx-auto w-16 h-1 rounded-full bg-sand-400"></div>
    </div>

    <% if @competitions.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <% @competitions.each do |competition| %>
          <div class="bg-white rounded-xl shadow-md p-6">
            <div class="w-10 h-10 rounded-lg bg-sand-100 flex items-center justify-center mb-3">
              <svg class="h-5 w-5 text-sand-700" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
              </svg>
            </div>
            <h3 class="font-bold text-charcoal text-lg mb-2"><%= competition.name %></h3>
            <p class="text-base text-gray-700 leading-relaxed"><%= sanitize competition.description, tags: %w[strong em b i a br p], attributes: %w[href class target rel] %></p>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<%# ══════════════════════════════════════════════════════════════
     Section 4 — Fish of the Month Calendar
     ══════════════════════════════════════════════════════════════ %>
<section class="py-16 sm:py-20 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-charcoal">Fish of the Month</h2>
      <div class="mt-3 mx-auto w-16 h-1 rounded-full bg-sand-400"></div>
      <p class="mt-4 text-base text-gray-700 max-w-xl mx-auto leading-relaxed">Each monthly comp features a selected target species — bonus points are awarded for catching it. Season 2026–2027 calendar:</p>
    </div>

    <% if @fish_of_the_months.any? %>
      <div class="bg-offwhite rounded-xl shadow-md overflow-hidden">
        <table class="w-full text-base">
          <thead class="bg-navy-900 text-white text-left text-xs uppercase tracking-wider">
            <tr>
              <th class="px-6 py-3">Date</th>
              <th class="px-6 py-3 text-right">Target</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @fish_of_the_months.reject(&:special_event?).each do |entry| %>
              <tr class="hover:bg-white">
                <td class="px-6 py-3 font-medium text-charcoal"><%= entry.fishing_date.strftime("%a %-d %B %Y") %></td>
                <td class="px-6 py-3 text-right font-bold text-ocean-700"><%= entry.target_species %></td>
              </tr>
            <% end %>
            <% @fish_of_the_months.select(&:special_event?).each do |entry| %>
              <tr class="bg-sand-100/60 hover:bg-sand-100">
                <td class="px-6 py-3 font-medium text-charcoal"><%= entry.fishing_date.strftime("%a %-d %B %Y") %></td>
                <td class="px-6 py-3 text-right font-bold text-coral-700"><%= entry.target_species %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <p class="text-center text-sm text-gray-600 mt-4">Special events highlighted in sand.</p>
    <% end %>
  </div>
</section>

<%# ══════════════════════════════════════════════════════════════
     Section 5 — How It Works
     ══════════════════════════════════════════════════════════════ %>
<section class="py-16 sm:py-20 bg-offwhite">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-charcoal">How It Works</h2>
      <div class="mt-3 mx-auto w-16 h-1 rounded-full bg-sand-400"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="bg-white rounded-xl shadow-md p-6">
        <h3 class="font-bold text-charcoal text-lg mb-3">Weigh-In</h3>
        <ul class="space-y-2 text-base text-gray-700">
          <li class="flex items-start gap-2">
            <span class="text-ocean-700 font-bold mt-0.5">&#8226;</span>
            <span>Held at the clubrooms between <strong class="text-charcoal">5pm and 6pm</strong> on competition day</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-ocean-700 font-bold mt-0.5">&#8226;</span>
            <span>All fish must be weighed in <strong class="text-charcoal">scaled and gutted</strong></span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-ocean-700 font-bold mt-0.5">&#8226;</span>
            <span>See the <%= link_to "Fish Points page", fish_points_path, class: "text-ocean-700 underline hover:text-ocean-600" %> for the current points system</span>
          </li>
        </ul>
      </div>

      <div class="bg-white rounded-xl shadow-md p-6">
        <h3 class="font-bold text-charcoal text-lg mb-3">Monthly Prizes</h3>
        <ul class="space-y-2 text-base text-gray-700">
          <li class="flex items-start gap-2">
            <span class="text-ocean-700 font-bold mt-0.5">&#8226;</span>
            <span>Junior Female / Male (under 16): <strong class="text-charcoal">$25</strong></span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-ocean-700 font-bold mt-0.5">&#8226;</span>
            <span>Senior Female / Male: <strong class="text-charcoal">$50</strong></span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-ocean-700 font-bold mt-0.5">&#8226;</span>
            <span>Veteran (over 60): <strong class="text-charcoal">$50</strong></span>
          </li>
        </ul>
        <p class="text-sm text-gray-600 mt-3">Awarded to the heaviest Fish of the Month (or heaviest other species if none caught) in each section.</p>
      </div>

      <div class="bg-white rounded-xl shadow-md p-6">
        <h3 class="font-bold text-charcoal text-lg mb-3">Yearly Champions</h3>
        <ul class="space-y-2 text-base text-gray-700">
          <li class="flex items-start gap-2">
            <span class="text-ocean-700 font-bold mt-0.5">&#8226;</span>
            <span>Juniors — Runner-up <strong class="text-charcoal">$25</strong>, Champion <strong class="text-charcoal">$50</strong></span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-ocean-700 font-bold mt-0.5">&#8226;</span>
            <span>Seniors — Runner-up <strong class="text-charcoal">$50</strong>, Champion <strong class="text-charcoal">$100</strong></span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-ocean-700 font-bold mt-0.5">&#8226;</span>
            <span>Veterans — Runner-up <strong class="text-charcoal">$50</strong>, Champion <strong class="text-charcoal">$100</strong></span>
          </li>
        </ul>
        <p class="text-sm text-gray-600 mt-3">Points accumulate across the season and are presented at the end-of-season night.</p>
      </div>

      <div class="bg-white rounded-xl shadow-md p-6">
        <h3 class="font-bold text-charcoal text-lg mb-3">Membership Card</h3>
        <p class="text-base text-gray-700 leading-relaxed">Your membership card shows your name, member number, weigh-in times, competition days, and monthly access.</p>
      </div>

      <div class="bg-white rounded-xl shadow-md p-6 sm:col-span-2">
        <h3 class="font-bold text-charcoal text-lg mb-3">Raffles & Dinner</h3>
        <p class="text-base text-gray-700 leading-relaxed">Raffles are conducted at each weigh-in with several prizes up for grabs — meat trays and vouchers are regulars. Dinner and snacks are provided at weigh-in on competition days.</p>
      </div>
    </div>
  </div>
</section>

<%# ══════════════════════════════════════════════════════════════
     Section 6 — Life Members
     ══════════════════════════════════════════════════════════════ %>
<section class="py-16 sm:py-20 bg-gradient-to-br from-navy-900 via-navy-800 to-ocean-800 text-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold">Life Members</h2>
      <div class="mt-3 mx-auto w-16 h-1 rounded-full bg-sand-400"></div>
      <p class="mt-4 text-base text-navy-100 leading-relaxed">Recognising those who have given outstanding service to the club.</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      <% life_members = [
        { name: "P. Barry" },
        { name: "S. Macaulay" },
        { name: "H. Williams", deceased: true },
        { name: "H. Fraser", deceased: true },
        { name: "E. Bentick", deceased: true },
        { name: "K. Bentick", deceased: true },
        { name: "D. Beech", deceased: true },
        { name: "A. Bentick" },
        { name: "R. Hamilton" },
        { name: "P. Clarke" },
        { name: "A. McFayden", deceased: true },
        { name: "C. Haines", deceased: true },
        { name: "R. Haines" },
        { name: "I. Kent" },
        { name: "G. Scott" },
        { name: "W. Humphrey" },
        { name: "L. Bentick" },
        { name: "S. McFayden" },
        { name: "S. Howell" },
        { name: "B. Sharples" },
        { name: "D. Sharples" },
      ] %>
      <% life_members.each do |member| %>
        <div class="bg-white/15 backdrop-blur-sm rounded-lg p-3 text-center border border-white/20">
          <p class="font-medium text-base text-white">
            <%= member[:name] %>
            <% if member[:deceased] %>
              <span class="text-navy-100 text-xs">*</span>
            <% end %>
          </p>
        </div>
      <% end %>
    </div>

    <p class="text-center text-navy-100 text-sm mt-6">* Deceased</p>
  </div>
</section>
