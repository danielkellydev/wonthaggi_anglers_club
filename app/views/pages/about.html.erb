<% content_for :title, "About" %>
<% content_for :description, "Wonthaggi Angling Club is a community of passionate anglers in the Bass Coast region. Monthly competitions, social events, and a welcoming clubroom on McBride Avenue, Wonthaggi." %>
<% content_for :head do %>
  <%= render "shared/structured_data" %>
<% end %>

<%# ══════════════════════════════════════════════════════════════
     Section 1 — About the Club
     ══════════════════════════════════════════════════════════════ %>
<section class="py-16 sm:py-20 bg-offwhite">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-charcoal">About the Club</h2>
      <div class="mt-3 mx-auto w-16 h-1 rounded-full bg-sand-400"></div>
    </div>

    <div class="bg-white rounded-xl shadow-md p-8 text-base text-gray-700 leading-relaxed space-y-4">
      <p>Wonthaggi Angling Club is a community of passionate anglers based in the heart of the Bass Coast region. Whether you're a weekend warrior chasing flathead or a seasoned pro targeting snapper, there's a place for you here.</p>
      <p>We run regular competitions, social events, and provide a welcoming clubroom for members to gather, share stories, and enjoy great company.</p>
    </div>
  </div>
</section>

<%# ══════════════════════════════════════════════════════════════
     Section 2 — Clubrooms
     ══════════════════════════════════════════════════════════════ %>
<section class="py-16 sm:py-20 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-charcoal">Clubrooms</h2>
      <div class="mt-3 mx-auto w-16 h-1 rounded-full bg-sand-400"></div>
    </div>

    <div class="bg-offwhite rounded-xl p-8 space-y-4">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-lg bg-ocean-100 flex items-center justify-center shrink-0 mt-1">
          <svg class="h-5 w-5 text-ocean-700" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-charcoal text-lg">Location</h3>
          <p class="text-base text-gray-700">McBride Avenue, Wonthaggi (near the main grandstand at the recreation reserve).</p>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-lg bg-ocean-100 flex items-center justify-center shrink-0 mt-1">
          <svg class="h-5 w-5 text-ocean-700" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8.25v-1.5m0 1.5c-1.355 0-2.697.056-4.024.166C6.845 8.51 6 9.473 6 10.608v2.513m6-4.871c1.355 0 2.697.056 4.024.166C17.155 8.51 18 9.473 18 10.608v2.513M15 8.25v-1.5m-6 1.5v-1.5m12 9.75l-1.5.75a3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0L3 16.5m15-3.379a48.474 48.474 0 00-6-.371c-2.032 0-4.034.126-6 .371m12 0c.39.049.777.102 1.163.16 1.07.16 1.837 1.094 1.837 2.175v5.169c0 .621-.504 1.125-1.125 1.125H4.125A1.125 1.125 0 013 20.625v-5.17c0-1.08.768-2.014 1.837-2.174A47.78 47.78 0 016 13.12M12.265 3.11a.375.375 0 11-.53 0L12 2.845l.265.265zm-3 0a.375.375 0 11-.53 0L9 2.845l.265.265zm6 0a.375.375 0 11-.53 0L15 2.845l.265.265z" />
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-charcoal text-lg">Facilities</h3>
          <p class="text-base text-gray-700">Licensed premises with all refreshments available at reasonable prices. EFTPOS available. Finger foods and snacks available on competition days.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ══════════════════════════════════════════════════════════════
     Section 3 — Competitions
     ══════════════════════════════════════════════════════════════ %>
<section class="py-16 sm:py-20 bg-offwhite">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-charcoal">Competitions</h2>
      <div class="mt-3 mx-auto w-16 h-1 rounded-full bg-sand-400"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <%# Monthly Competition %>
      <div class="bg-white rounded-xl shadow-md p-6">
        <div class="w-10 h-10 rounded-lg bg-sand-100 flex items-center justify-center mb-3">
          <svg class="h-5 w-5 text-sand-700" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
          </svg>
        </div>
        <h3 class="font-bold text-charcoal text-lg mb-2">Monthly Competition</h3>
        <p class="text-base text-gray-700 leading-relaxed">Held on the third Sunday of each month. Fish can be entered from any open Victorian waters. Entry between 5pm and 6pm on competition day.</p>
      </div>

      <%# 365 Competition %>
      <div class="bg-white rounded-xl shadow-md p-6">
        <div class="w-10 h-10 rounded-lg bg-sand-100 flex items-center justify-center mb-3">
          <svg class="h-5 w-5 text-sand-700" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.996.428-1.817 1.091-2.402 1.902M18.75 4.236c.996.428 1.816 1.091 2.402 1.902M12 2.25c2.29 0 4.376.86 5.963 2.272M12 2.25c-2.29 0-4.376.86-5.963 2.272" />
          </svg>
        </div>
        <h3 class="font-bold text-charcoal text-lg mb-2">365 Competition</h3>
        <p class="text-base text-gray-700 leading-relaxed">Selected fish entered at a cost of $2. Entry must be presented within a month of catching. Fish can be weighed at Wonthaggi or contact 0468 349 668, or at the club on comp days.</p>
      </div>

      <%# Three Rivers Competition %>
      <div class="bg-white rounded-xl shadow-md p-6">
        <div class="w-10 h-10 rounded-lg bg-sand-100 flex items-center justify-center mb-3">
          <svg class="h-5 w-5 text-sand-700" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z" />
          </svg>
        </div>
        <h3 class="font-bold text-charcoal text-lg mb-2">Three Rivers Competition</h3>
        <p class="text-base text-gray-700 leading-relaxed">Held on the Saturday following the May monthly competition. Selected fish with a barbecue at weigh-in. Minimal entry fee. Rivers: Tambo, Nicholson, and Mitchell. Visitors most welcome.</p>
      </div>

      <%# Tambo River Competition %>
      <div class="bg-white rounded-xl shadow-md p-6">
        <div class="w-10 h-10 rounded-lg bg-sand-100 flex items-center justify-center mb-3">
          <svg class="h-5 w-5 text-sand-700" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z" />
          </svg>
        </div>
        <h3 class="font-bold text-charcoal text-lg mb-2">Tambo River Competition</h3>
        <p class="text-base text-gray-700 leading-relaxed">Held on the Saturday following the October monthly competition. Only the Tambo River can be fished. Includes a barbecue at weigh-in. Minimal entry fee. Visitors most welcome.</p>
      </div>
    </div>
  </div>
</section>

<%# ══════════════════════════════════════════════════════════════
     Section 4 — Weigh-In & Double Points
     ══════════════════════════════════════════════════════════════ %>
<section class="py-16 sm:py-20 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-charcoal">How It Works</h2>
      <div class="mt-3 mx-auto w-16 h-1 rounded-full bg-sand-400"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="bg-offwhite rounded-xl p-6">
        <h3 class="font-bold text-charcoal text-lg mb-3">Weigh-In</h3>
        <ul class="space-y-2 text-base text-gray-700">
          <li class="flex items-start gap-2">
            <span class="text-ocean-700 font-bold mt-0.5">&#8226;</span>
            <span>Held at the clubrooms between <strong class="text-charcoal">5pm and 6pm</strong> on competition day</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-ocean-700 font-bold mt-0.5">&#8226;</span>
            <span>All fish must be weighed in <strong class="text-charcoal">scaled and gutted</strong></span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-ocean-700 font-bold mt-0.5">&#8226;</span>
            <span>Points are calculated per 10 grams of fish weight</span>
          </li>
        </ul>
      </div>

      <div class="bg-offwhite rounded-xl p-6">
        <h3 class="font-bold text-charcoal text-lg mb-3">Double Points</h3>
        <p class="text-base text-gray-700 leading-relaxed">Each monthly competition features a selected species that earns <strong class="text-charcoal">double points</strong> at weigh-in. All other species earn regular points. Check the latest news for each month's double-point species.</p>
      </div>

      <div class="bg-offwhite rounded-xl p-6">
        <h3 class="font-bold text-charcoal text-lg mb-3">Membership Card</h3>
        <p class="text-base text-gray-700 leading-relaxed">Your membership card shows your name, member number, weigh-in times, competition days, and monthly access. It also allows you to take advantage of the double point opportunity.</p>
      </div>

      <div class="bg-offwhite rounded-xl p-6">
        <h3 class="font-bold text-charcoal text-lg mb-3">Raffles & Snacks</h3>
        <p class="text-base text-gray-700 leading-relaxed">Raffles are conducted at each weigh-in with several prizes up for grabs. Finger foods and snacks are available on competition days.</p>
      </div>
    </div>
  </div>
</section>

<%# ══════════════════════════════════════════════════════════════
     Section 5 — Life Members
     ══════════════════════════════════════════════════════════════ %>
<section class="py-16 sm:py-20 bg-gradient-to-br from-navy-900 via-navy-800 to-ocean-800 text-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold">Life Members</h2>
      <div class="mt-3 mx-auto w-16 h-1 rounded-full bg-sand-400"></div>
      <p class="mt-4 text-base text-navy-100 leading-relaxed">Recognising those who have given outstanding service to the club.</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      <% life_members = [
        { name: "P. Barry" },
        { name: "D. Beech", deceased: true },
        { name: "A. Bentick" },
        { name: "E. Bentick", deceased: true },
        { name: "K. Bentick", deceased: true },
        { name: "L. Bentick" },
        { name: "P. Clarke" },
        { name: "C. Haines", deceased: true },
        { name: "R. Haines" },
        { name: "R. Hamilton", deceased: true },
        { name: "S. Howell" },
        { name: "I. Kent" },
        { name: "S. McCauley" },
        { name: "A. McFayden", deceased: true },
        { name: "S. McFayden" },
        { name: "G. Scott" },
        { name: "B. Sharples" },
        { name: "D. Sharples" },
        { name: "H. Williams", deceased: true },
        { name: "H. Fraser", deceased: true },
      ] %>
      <% life_members.each do |member| %>
        <div class="bg-white/15 backdrop-blur-sm rounded-lg p-3 text-center border border-white/20">
          <p class="font-medium text-base text-white">
            <%= member[:name] %>
            <% if member[:deceased] %>
              <span class="text-navy-100 text-xs">*</span>
            <% end %>
          </p>
        </div>
      <% end %>
    </div>

    <p class="text-center text-navy-100 text-sm mt-6">* Deceased</p>
  </div>
</section>
