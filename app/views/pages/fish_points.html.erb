<section class="py-16 sm:py-20 bg-offwhite">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <%# Section heading %>
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-charcoal">Fish Points</h2>
      <div class="mt-3 mx-auto w-16 h-1 rounded-full bg-sand-400"></div>
      <p class="mt-4 text-gray-600 max-w-xl mx-auto">Points are calculated per 10 grams of fish weighed in. All fish must be weighed in scaled and gutted.</p>
    </div>

    <% if @fish_points.any? %>
      <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-navy-900 text-white text-left text-xs uppercase tracking-wider">
            <tr>
              <th class="px-6 py-3">Species</th>
              <th class="px-6 py-3 text-right">Points (per 10g)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @fish_points.each do |fp| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-3 font-medium text-charcoal">
                  <%= fp.name %>
                  <% if fp.notes.present? %>
                    <span class="text-xs text-gray-500 ml-1">(<%= fp.notes %>)</span>
                  <% end %>
                </td>
                <td class="px-6 py-3 text-right font-bold text-ocean-700">
                  <% if fp.points > 0 %>
                    <%= fp.points %>
                  <% else %>
                    <span class="text-xs font-medium text-coral-600"><%= fp.notes %></span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-center text-gray-500">Fish points coming soon.</p>
    <% end %>
  </div>
</section>
