<% content_for :title, "Membership" %>
<% content_for :description, "Join Wonthaggi Angling Club. Annual memberships from a few categories give you access to monthly competitions, social events, and a great community of Bass Coast anglers." %>

<%# ══════════════════════════════════════════════════════════════
     Section 1 — Membership Fees
     ══════════════════════════════════════════════════════════════ %>
<section class="py-16 sm:py-20 bg-offwhite">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-charcoal">Membership</h2>
      <div class="mt-3 mx-auto w-16 h-1 rounded-full bg-sand-400"></div>
      <p class="mt-4 text-base text-gray-700 max-w-xl mx-auto leading-relaxed">Annual membership fees are due each April. Join the club and get access to monthly competitions, social events, and a great community of anglers.</p>
    </div>

    <% if @membership_fees.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <% @membership_fees.each do |fee| %>
          <div class="bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow p-6 text-center">
            <h3 class="text-lg font-bold text-charcoal mb-2"><%= fee.name %></h3>
            <p class="text-4xl font-extrabold text-ocean-700 mb-2"><%= number_to_currency(fee.amount, precision: 0) %></p>
            <p class="text-base text-gray-700">per year</p>
            <% if fee.description.present? %>
              <p class="mt-3 text-sm text-coral-700 font-medium"><%= fee.description %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<%# ══════════════════════════════════════════════════════════════
     Section 2 — Committee
     ══════════════════════════════════════════════════════════════ %>
<% if @committee_members.any? %>
  <section id="committee" class="py-16 sm:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-charcoal">Committee</h2>
        <div class="mt-3 mx-auto w-16 h-1 rounded-full bg-sand-400"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl mx-auto">
        <% @committee_members.each do |member| %>
          <div class="bg-offwhite rounded-xl p-6 text-center">
            <p class="text-sm font-semibold uppercase tracking-wider text-ocean-700 mb-1"><%= member.role %></p>
            <h3 class="text-lg font-bold text-charcoal"><%= member.name %></h3>
            <% if member.phone.present? %>
              <p class="mt-2 text-base text-gray-700">
                <a href="tel:<%= member.phone %>" class="hover:text-ocean-700 transition-colors"><%= member.phone %></a>
              </p>
            <% end %>
            <% if member.email.present? %>
              <p class="mt-1 text-base text-gray-700 break-words">
                <a href="mailto:<%= member.email %>" class="hover:text-ocean-700 transition-colors"><%= member.email %></a>
              </p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<%# ══════════════════════════════════════════════════════════════
     Section 3 — Join Us
     ══════════════════════════════════════════════════════════════ %>
<section class="py-16 sm:py-20 bg-gradient-to-br from-navy-900 via-navy-800 to-ocean-800 text-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold mb-4">Join Us</h2>
    <div class="mx-auto w-16 h-1 rounded-full bg-sand-400 mb-6"></div>
    <p class="text-lg text-navy-100 leading-relaxed mb-8 max-w-xl mx-auto">
      Download the membership form below, print it out, and bring it along to the clubrooms to sign up and pay in person.
    </p>
    <% if @membership_form&.file&.attached? %>
      <%= link_to rails_blob_path(@membership_form.file, disposition: "attachment"), class: "inline-flex items-center gap-2 px-8 py-3 rounded-lg text-lg font-semibold bg-sand-400 text-navy-950 hover:bg-sand-300 transition-colors shadow-lg hover:shadow-xl" do %>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        Download Membership Form
      <% end %>
    <% else %>
      <p class="text-base text-navy-100">Membership form coming soon. Contact a committee member above for details.</p>
    <% end %>
  </div>
</section>
