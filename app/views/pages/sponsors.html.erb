<% content_for :title, "Sponsors" %>
<% content_for :description, "Local businesses and organisations who proudly support the Wonthaggi Angling Club." %>

<section class="py-16 sm:py-20 bg-offwhite">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-charcoal">Our Sponsors</h2>
      <div class="mt-3 mx-auto w-16 h-1 rounded-full bg-sand-400"></div>
      <p class="mt-4 text-base text-gray-700 max-w-xl mx-auto leading-relaxed">We're grateful to the local businesses and organisations that support the Wonthaggi Angling Club.</p>
    </div>

    <% if @sponsors.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @sponsors.each do |sponsor| %>
          <div class="bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow p-6 flex flex-col items-center text-center">
            <% if sponsor.logo.attached? %>
              <div class="h-24 flex items-center justify-center mb-4">
                <%= image_tag sponsor.logo.variant(resize_to_fit: [200, 96]), alt: sponsor.name, loading: "lazy", decoding: "async", class: "max-h-full w-auto object-contain" %>
              </div>
            <% end %>
            <h3 class="text-lg font-bold text-charcoal mb-1"><%= sponsor.name %></h3>
            <% if sponsor.website_url.present? %>
              <a href="<%= sponsor.website_url %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-base text-ocean-700 hover:text-ocean-600 transition-colors">
                Visit Website
                <svg class="inline h-3.5 w-3.5 ml-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              </a>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-center text-base text-gray-700">Sponsor information coming soon.</p>
    <% end %>
  </div>
</section>

<section class="py-16 sm:py-20 bg-gradient-to-br from-navy-900 via-navy-800 to-ocean-800 text-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold mb-4">Become a Sponsor</h2>
    <div class="mx-auto w-16 h-1 rounded-full bg-sand-400 mb-6"></div>
    <p class="text-lg text-navy-100 leading-relaxed mb-8 max-w-xl mx-auto">
      Interested in supporting the Wonthaggi Angling Club? We'd love to hear from you. Your logo will be featured on our website and at club events.
    </p>
    <%= link_to "Get in Touch", membership_path(anchor: "committee"), class: "inline-flex items-center px-8 py-3 rounded-lg text-lg font-semibold bg-sand-400 text-navy-950 hover:bg-sand-300 transition-colors shadow-lg hover:shadow-xl" %>
  </div>
</section>
