<section class="py-16 sm:py-20 bg-offwhite">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h1 class="text-3xl sm:text-4xl font-bold text-charcoal">News & Updates</h1>
      <div class="mt-3 mx-auto w-16 h-1 rounded-full bg-sand-400"></div>
    </div>

    <% if @posts.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <% @posts.each do |post| %>
          <%= render "posts/card", post: post %>
        <% end %>
      </div>
    <% else %>
      <p class="text-center text-base text-gray-700">No posts yet. Check back soon!</p>
    <% end %>
  </div>
</section>
