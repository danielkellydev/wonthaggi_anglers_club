<article class="bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow overflow-hidden group">
  <% if post.featured_image.attached? %>
    <%= image_tag post.featured_image.variant(resize_to_fill: [600, 400]), class: "h-48 w-full object-cover" %>
  <% else %>
    <% gradient = { "news" => "from-ocean-600 to-ocean-800", "report" => "from-sand-400 to-sand-600", "announcement" => "from-coral-400 to-coral-600" }[post.category] %>
    <div class="h-48 bg-gradient-to-br <%= gradient %> relative">
      <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
    </div>
  <% end %>
  <div class="p-6">
    <div class="flex items-center gap-3 mb-3">
      <% badge = { "news" => "bg-ocean-100 text-ocean-800", "report" => "bg-sand-100 text-sand-800", "announcement" => "bg-coral-50 text-coral-700" }[post.category] %>
      <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold <%= badge %>"><%= post.category.capitalize %></span>
      <% if post.published_at %>
        <time class="text-sm text-gray-500"><%= post.published_at.strftime("%-d %b %Y") %></time>
      <% end %>
    </div>
    <h3 class="text-lg font-bold text-charcoal mb-2 group-hover:text-ocean-700 transition-colors">
      <%= post.title %>
    </h3>
    <% if post.body.present? %>
      <p class="text-gray-600 text-sm leading-relaxed mb-4"><%= truncate(post.body.to_plain_text, length: 150) %></p>
    <% end %>
    <%= link_to post_path(post), class: "text-sm font-semibold text-ocean-700 hover:text-ocean-600 transition-colors" do %>
      Read More &rarr;
    <% end %>
  </div>
</article>
