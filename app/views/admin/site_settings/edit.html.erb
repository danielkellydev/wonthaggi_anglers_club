<h1 class="text-2xl font-bold text-charcoal mb-6">Site Settings</h1>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
  <h2 class="text-lg font-bold text-charcoal mb-4">Membership Form (PDF)</h2>
  <p class="text-sm text-gray-500 mb-4">Upload a PDF membership form. Visitors will be able to download this from the membership page and "Join Us" links across the site.</p>

  <% if @membership_form.file.attached? %>
    <div class="mb-6 p-4 bg-green-50 rounded-lg">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <svg class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
          <div>
            <p class="text-sm font-medium text-green-800"><%= @membership_form.file.filename %></p>
            <p class="text-xs text-green-600"><%= number_to_human_size(@membership_form.file.byte_size) %></p>
          </div>
        </div>
        <%= button_to "Remove", destroy_file_admin_site_settings_path, method: :delete, class: "text-sm text-red-600 hover:text-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Remove the membership form?" } %>
      </div>
    </div>
  <% end %>

  <%= form_with model: @membership_form, url: admin_site_settings_path, method: :patch, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :file, @membership_form.file.attached? ? "Replace file" : "Upload file", class: "block text-sm font-medium text-charcoal mb-1" %>
      <%= form.file_field :file, accept: "application/pdf", class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-ocean-50 file:text-ocean-700 hover:file:bg-ocean-100" %>
    </div>

    <div>
      <%= form.submit "Upload", class: "inline-flex items-center px-6 py-2.5 rounded-lg bg-ocean-700 text-white font-semibold hover:bg-ocean-600 transition-colors cursor-pointer" %>
    </div>
  <% end %>
</div>
