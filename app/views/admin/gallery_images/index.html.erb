<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-charcoal">Gallery</h1>
  <%= link_to "Add Image", new_admin_gallery_image_path, class: "inline-flex items-center px-4 py-2 rounded-lg bg-ocean-700 text-white text-sm font-semibold hover:bg-ocean-600 transition-colors" %>
</div>

<% if @gallery_images.any? %>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
    <% @gallery_images.each do |gallery_image| %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <% if gallery_image.image.attached? %>
          <%= image_tag gallery_image.image.variant(resize_to_fill: [400, 400]), class: "w-full aspect-square object-cover" %>
        <% else %>
          <div class="w-full aspect-square bg-gray-100 flex items-center justify-center text-gray-400">
            <svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z" />
            </svg>
          </div>
        <% end %>
        <div class="p-3">
          <p class="text-sm text-gray-600 truncate"><%= gallery_image.caption.presence || "No caption" %></p>
          <p class="text-xs text-gray-400">Position: <%= gallery_image.position %></p>
          <div class="flex items-center gap-3 mt-2">
            <%= link_to "Edit", edit_admin_gallery_image_path(gallery_image), class: "text-xs text-ocean-700 hover:text-ocean-600 font-medium" %>
            <%= button_to "Delete", admin_gallery_image_path(gallery_image), method: :delete, class: "text-xs text-red-600 hover:text-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Delete this image?" } %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8 text-center">
    <p class="text-gray-500">No gallery images yet. <%= link_to "Add one", new_admin_gallery_image_path, class: "text-ocean-700 hover:text-ocean-600 font-medium" %>.</p>
  </div>
<% end %>
