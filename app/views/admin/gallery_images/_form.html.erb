<%= form_with model: [:admin, gallery_image], class: "space-y-6" do |form| %>
  <% if gallery_image.errors.any? %>
    <div class="bg-red-50 rounded-lg p-4">
      <p class="text-red-600 font-medium text-sm mb-2"><%= pluralize(gallery_image.errors.count, "error") %> prevented this image from being saved:</p>
      <ul class="list-disc list-inside text-sm text-red-500">
        <% gallery_image.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :image, class: "block text-sm font-medium text-charcoal mb-1" %>
    <% if gallery_image.image.attached? %>
      <div class="mb-2">
        <%= image_tag gallery_image.image.variant(resize_to_fill: [200, 200]), class: "rounded-lg" %>
      </div>
    <% end %>
    <%= form.file_field :image, accept: "image/jpeg,image/png,image/webp", class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-ocean-50 file:text-ocean-700 hover:file:bg-ocean-100" %>
  </div>

  <div>
    <%= form.label :caption, class: "block text-sm font-medium text-charcoal mb-1" %>
    <%= form.text_field :caption, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-ocean-600 focus:border-transparent" %>
  </div>

  <div>
    <%= form.label :position, class: "block text-sm font-medium text-charcoal mb-1" %>
    <%= form.number_field :position, class: "block w-32 rounded-lg border border-gray-300 px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-ocean-600 focus:border-transparent" %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit class: "inline-flex items-center px-6 py-2.5 rounded-lg bg-ocean-700 text-white font-semibold hover:bg-ocean-600 transition-colors cursor-pointer" %>
    <%= link_to "Cancel", admin_gallery_images_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>
<% end %>
