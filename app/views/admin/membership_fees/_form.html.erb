<%= form_with model: [:admin, membership_fee], class: "space-y-6" do |form| %>
  <% if membership_fee.errors.any? %>
    <div class="bg-red-50 rounded-lg p-4">
      <p class="text-red-600 font-medium text-sm mb-2"><%= pluralize(membership_fee.errors.count, "error") %> prevented this fee from being saved:</p>
      <ul class="list-disc list-inside text-sm text-red-500">
        <% membership_fee.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Category name", class: "block text-sm font-medium text-charcoal mb-1" %>
    <%= form.text_field :name, class: "block w-full rounded-lg border border-gray-300 px-3 py-3 text-base focus:outline-none focus:ring-2 focus:ring-ocean-600 focus:border-transparent" %>
  </div>

  <div>
    <%= form.label :amount, "Annual fee ($)", class: "block text-sm font-medium text-charcoal mb-1" %>
    <%= form.number_field :amount, step: 0.01, class: "block w-32 rounded-lg border border-gray-300 px-3 py-3 text-base focus:outline-none focus:ring-2 focus:ring-ocean-600 focus:border-transparent" %>
  </div>

  <div>
    <%= form.label :description, "Description (optional)", class: "block text-sm font-medium text-charcoal mb-1" %>
    <%= form.text_field :description, placeholder: "e.g. Ineligible to weigh in fish", class: "block w-full rounded-lg border border-gray-300 px-3 py-3 text-base focus:outline-none focus:ring-2 focus:ring-ocean-600 focus:border-transparent" %>
  </div>

  <div>
    <%= form.label :position, class: "block text-sm font-medium text-charcoal mb-1" %>
    <%= form.number_field :position, class: "block w-32 rounded-lg border border-gray-300 px-3 py-3 text-base focus:outline-none focus:ring-2 focus:ring-ocean-600 focus:border-transparent" %>
  </div>

  <div class="flex flex-col-reverse sm:flex-row sm:items-center gap-3">
    <%= form.submit class: "w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 min-h-[48px] rounded-lg bg-ocean-700 text-white font-semibold hover:bg-ocean-600 transition-colors cursor-pointer" %>
    <%= link_to "Cancel", admin_membership_fees_path, class: "w-full sm:w-auto inline-flex items-center justify-center sm:px-2 min-h-[44px] text-sm text-gray-500 hover:text-gray-700" %>
  </div>
<% end %>
