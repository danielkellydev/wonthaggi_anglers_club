<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-charcoal">Sponsors</h1>
  <%= link_to "New Sponsor", new_admin_sponsor_path, class: "inline-flex items-center px-4 py-2 rounded-lg bg-ocean-700 text-white text-sm font-semibold hover:bg-ocean-600 transition-colors" %>
</div>

<% if @sponsors.any? %>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
    <% @sponsors.each do |sponsor| %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <% if sponsor.logo.attached? %>
          <div class="aspect-[3/2] bg-gray-50 flex items-center justify-center p-4">
            <%= image_tag sponsor.logo.variant(resize_to_fit: [300, 200]), class: "max-h-full max-w-full object-contain" %>
          </div>
        <% else %>
          <div class="aspect-[3/2] bg-gray-100 flex items-center justify-center text-gray-400">
            <svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z" />
            </svg>
          </div>
        <% end %>
        <div class="p-3">
          <p class="text-sm font-medium text-charcoal truncate"><%= sponsor.name %></p>
          <% if sponsor.website_url.present? %>
            <p class="text-xs text-gray-400 truncate"><%= sponsor.website_url %></p>
          <% end %>
          <p class="text-xs text-gray-400">Position: <%= sponsor.position %></p>
          <div class="flex items-center gap-3 mt-2">
            <%= link_to "Edit", edit_admin_sponsor_path(sponsor), class: "text-xs text-ocean-700 hover:text-ocean-600 font-medium" %>
            <%= button_to "Delete", admin_sponsor_path(sponsor), method: :delete, class: "text-xs text-red-600 hover:text-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Delete this sponsor?" } %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8 text-center">
    <p class="text-gray-500">No sponsors yet. <%= link_to "Add one", new_admin_sponsor_path, class: "text-ocean-700 hover:text-ocean-600 font-medium" %>.</p>
  </div>
<% end %>
