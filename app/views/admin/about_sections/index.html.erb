<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
  <h1 class="text-2xl font-bold text-charcoal">About Page Sections</h1>
  <%= link_to "New Section", new_admin_about_section_path, class: "inline-flex items-center justify-center px-4 py-2.5 rounded-lg bg-ocean-700 text-white text-sm font-semibold hover:bg-ocean-600 transition-colors min-h-[44px]" %>
</div>

<p class="text-sm text-gray-500 mb-6">Sections are displayed on the public About page in position order. Unpublished sections are hidden from visitors.</p>

<% if @about_sections.any? %>
  <%# Desktop/tablet table %>
  <div class="hidden md:block bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-xs uppercase tracking-wider text-gray-500">
        <tr>
          <th class="px-6 py-3">Title</th>
          <th class="px-6 py-3">Status</th>
          <th class="px-6 py-3">Position</th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @about_sections.each do |section| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 font-medium"><%= section.title %></td>
            <td class="px-6 py-4">
              <% if section.published? %>
                <span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800">Published</span>
              <% else %>
                <span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-600">Draft</span>
              <% end %>
            </td>
            <td class="px-6 py-4 text-gray-500"><%= section.position %></td>
            <td class="px-6 py-4 text-right space-x-3">
              <%= link_to "Edit", edit_admin_about_section_path(section), class: "text-ocean-700 hover:text-ocean-600 font-medium" %>
              <%= button_to "Delete", admin_about_section_path(section), method: :delete, class: "text-red-600 hover:text-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Delete this section?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Mobile card list %>
  <div class="md:hidden space-y-3">
    <% @about_sections.each do |section| %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
        <div class="flex items-start justify-between gap-3 mb-3">
          <h2 class="font-semibold text-charcoal leading-snug"><%= section.title %></h2>
          <% if section.published? %>
            <span class="shrink-0 inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800">Published</span>
          <% else %>
            <span class="shrink-0 inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-600">Draft</span>
          <% end %>
        </div>
        <p class="text-xs text-gray-500 mb-4">Position: <%= section.position %></p>
        <div class="flex items-center gap-2">
          <%= link_to "Edit", edit_admin_about_section_path(section), class: "flex-1 inline-flex items-center justify-center min-h-[44px] px-4 rounded-lg bg-ocean-50 text-ocean-700 font-semibold text-sm hover:bg-ocean-100 transition-colors" %>
          <%= button_to "Delete", admin_about_section_path(section), method: :delete, class: "flex-1 inline-flex items-center justify-center min-h-[44px] px-4 rounded-lg bg-red-50 text-red-600 font-semibold text-sm hover:bg-red-100 transition-colors cursor-pointer", form: { class: "flex-1" }, data: { turbo_confirm: "Delete this section?" } %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-100">
    <p class="px-6 py-8 text-center text-gray-500">No about sections yet. <%= link_to "Create one", new_admin_about_section_path, class: "text-ocean-700 hover:text-ocean-600 font-medium" %>.</p>
  </div>
<% end %>
