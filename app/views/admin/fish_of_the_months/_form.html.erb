<%= form_with model: [:admin, fish_of_the_month], class: "space-y-6" do |form| %>
  <% if fish_of_the_month.errors.any? %>
    <div class="bg-red-50 rounded-lg p-4">
      <p class="text-red-600 font-medium text-sm mb-2"><%= pluralize(fish_of_the_month.errors.count, "error") %> prevented this entry from being saved:</p>
      <ul class="list-disc list-inside text-sm text-red-500">
        <% fish_of_the_month.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :fishing_date, "Date", class: "block text-sm font-medium text-charcoal mb-1" %>
    <%= form.date_field :fishing_date, class: "block w-full rounded-lg border border-gray-300 px-3 py-3 text-base focus:outline-none focus:ring-2 focus:ring-ocean-600 focus:border-transparent" %>
  </div>

  <div>
    <%= form.label :target_species, "Target species / event name", class: "block text-sm font-medium text-charcoal mb-1" %>
    <%= form.text_field :target_species, placeholder: "e.g. Perch, Snapper, Local Bream Classic", class: "block w-full rounded-lg border border-gray-300 px-3 py-3 text-base focus:outline-none focus:ring-2 focus:ring-ocean-600 focus:border-transparent" %>
  </div>

  <div class="flex items-start gap-3">
    <%= form.check_box :special_event, class: "mt-1 h-5 w-5 rounded border-gray-300 text-ocean-700 focus:ring-ocean-600" %>
    <div>
      <%= form.label :special_event, class: "block text-sm font-medium text-charcoal" %>
      <p class="text-sm text-gray-500">Tick for standalone events (e.g. Local Bream Classic, Tambo River Comp) — these are highlighted in the public calendar.</p>
    </div>
  </div>

  <div class="flex flex-col-reverse sm:flex-row sm:items-center gap-3">
    <%= form.submit class: "w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 min-h-[48px] rounded-lg bg-ocean-700 text-white font-semibold hover:bg-ocean-600 transition-colors cursor-pointer" %>
    <%= link_to "Cancel", admin_fish_of_the_months_path, class: "w-full sm:w-auto inline-flex items-center justify-center sm:px-2 min-h-[44px] text-sm text-gray-500 hover:text-gray-700" %>
  </div>
<% end %>
