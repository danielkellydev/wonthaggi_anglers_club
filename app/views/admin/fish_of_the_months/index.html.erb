<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
  <h1 class="text-2xl font-bold text-charcoal">Fish of the Month</h1>
  <%= link_to "New Entry", new_admin_fish_of_the_month_path, class: "inline-flex items-center justify-center px-4 py-2.5 rounded-lg bg-ocean-700 text-white text-sm font-semibold hover:bg-ocean-600 transition-colors min-h-[44px]" %>
</div>

<% if @fish_of_the_months.any? %>
  <div class="hidden md:block bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-xs uppercase tracking-wider text-gray-500">
        <tr>
          <th class="px-6 py-3">Date</th>
          <th class="px-6 py-3">Target</th>
          <th class="px-6 py-3">Special Event</th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @fish_of_the_months.each do |entry| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 font-medium"><%= entry.fishing_date.strftime("%a %-d %b %Y") %></td>
            <td class="px-6 py-4"><%= entry.target_species %></td>
            <td class="px-6 py-4 text-gray-500"><%= entry.special_event? ? "Yes" : "—" %></td>
            <td class="px-6 py-4 text-right space-x-3">
              <%= link_to "Edit", edit_admin_fish_of_the_month_path(entry), class: "text-ocean-700 hover:text-ocean-600 font-medium" %>
              <%= button_to "Delete", admin_fish_of_the_month_path(entry), method: :delete, class: "text-red-600 hover:text-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Delete this entry?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="md:hidden space-y-3">
    <% @fish_of_the_months.each do |entry| %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
        <p class="text-xs uppercase tracking-wider text-gray-500"><%= entry.fishing_date.strftime("%a %-d %b %Y") %></p>
        <h2 class="font-semibold text-charcoal mb-2"><%= entry.target_species %></h2>
        <% if entry.special_event? %>
          <p class="text-xs text-coral-700 font-semibold mb-3">Special event</p>
        <% end %>
        <div class="flex items-center gap-2">
          <%= link_to "Edit", edit_admin_fish_of_the_month_path(entry), class: "flex-1 inline-flex items-center justify-center min-h-[44px] px-4 rounded-lg bg-ocean-50 text-ocean-700 font-semibold text-sm hover:bg-ocean-100 transition-colors" %>
          <%= button_to "Delete", admin_fish_of_the_month_path(entry), method: :delete, class: "flex-1 inline-flex items-center justify-center min-h-[44px] px-4 rounded-lg bg-red-50 text-red-600 font-semibold text-sm hover:bg-red-100 transition-colors cursor-pointer", form: { class: "flex-1" }, data: { turbo_confirm: "Delete this entry?" } %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-100">
    <p class="px-6 py-8 text-center text-gray-500">No entries yet. <%= link_to "Add one", new_admin_fish_of_the_month_path, class: "text-ocean-700 hover:text-ocean-600 font-medium" %>.</p>
  </div>
<% end %>
