<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
  <h1 class="text-2xl font-bold text-charcoal">Fish Points</h1>
  <%= link_to "New Fish Point", new_admin_fish_point_path, class: "inline-flex items-center justify-center px-4 py-2.5 rounded-lg bg-ocean-700 text-white text-sm font-semibold hover:bg-ocean-600 transition-colors min-h-[44px]" %>
</div>

<% if @fish_points.any? %>
  <%# Desktop/tablet table %>
  <div class="hidden md:block bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-xs uppercase tracking-wider text-gray-500">
        <tr>
          <th class="px-6 py-3">Species</th>
          <th class="px-6 py-3">Points (per 10g)</th>
          <th class="px-6 py-3">Notes</th>
          <th class="px-6 py-3">Position</th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @fish_points.each do |fish_point| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 font-medium"><%= fish_point.name %></td>
            <td class="px-6 py-4"><%= fish_point.points %></td>
            <td class="px-6 py-4 text-gray-500"><%= fish_point.notes %></td>
            <td class="px-6 py-4 text-gray-500"><%= fish_point.position %></td>
            <td class="px-6 py-4 text-right space-x-3">
              <%= link_to "Edit", edit_admin_fish_point_path(fish_point), class: "text-ocean-700 hover:text-ocean-600 font-medium" %>
              <%= button_to "Delete", admin_fish_point_path(fish_point), method: :delete, class: "text-red-600 hover:text-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Delete this fish point?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Mobile card list %>
  <div class="md:hidden space-y-3">
    <% @fish_points.each do |fish_point| %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
        <div class="flex items-start justify-between gap-3 mb-2">
          <h2 class="font-semibold text-charcoal"><%= fish_point.name %></h2>
          <span class="shrink-0 font-semibold text-ocean-700"><%= fish_point.points %> pts / 10g</span>
        </div>
        <% if fish_point.notes.present? %>
          <p class="text-sm text-gray-600 mb-4"><%= fish_point.notes %></p>
        <% end %>
        <div class="flex items-center gap-2">
          <%= link_to "Edit", edit_admin_fish_point_path(fish_point), class: "flex-1 inline-flex items-center justify-center min-h-[44px] px-4 rounded-lg bg-ocean-50 text-ocean-700 font-semibold text-sm hover:bg-ocean-100 transition-colors" %>
          <%= button_to "Delete", admin_fish_point_path(fish_point), method: :delete, class: "flex-1 inline-flex items-center justify-center min-h-[44px] px-4 rounded-lg bg-red-50 text-red-600 font-semibold text-sm hover:bg-red-100 transition-colors cursor-pointer", form: { class: "flex-1" }, data: { turbo_confirm: "Delete this fish point?" } %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-100">
    <p class="px-6 py-8 text-center text-gray-500">No fish points yet. <%= link_to "Create one", new_admin_fish_point_path, class: "text-ocean-700 hover:text-ocean-600 font-medium" %>.</p>
  </div>
<% end %>
