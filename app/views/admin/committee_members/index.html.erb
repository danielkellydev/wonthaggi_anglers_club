<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-charcoal">Committee Members</h1>
  <%= link_to "New Member", new_admin_committee_member_path, class: "inline-flex items-center px-4 py-2 rounded-lg bg-ocean-700 text-white text-sm font-semibold hover:bg-ocean-600 transition-colors" %>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
  <% if @committee_members.any? %>
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-xs uppercase tracking-wider text-gray-500">
        <tr>
          <th class="px-6 py-3">Role</th>
          <th class="px-6 py-3">Name</th>
          <th class="px-6 py-3">Phone</th>
          <th class="px-6 py-3">Email</th>
          <th class="px-6 py-3">Position</th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @committee_members.each do |member| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 font-medium"><%= member.role %></td>
            <td class="px-6 py-4"><%= member.name %></td>
            <td class="px-6 py-4 text-gray-500"><%= member.phone %></td>
            <td class="px-6 py-4 text-gray-500"><%= member.email %></td>
            <td class="px-6 py-4 text-gray-500"><%= member.position %></td>
            <td class="px-6 py-4 text-right space-x-3">
              <%= link_to "Edit", edit_admin_committee_member_path(member), class: "text-ocean-700 hover:text-ocean-600 font-medium" %>
              <%= button_to "Delete", admin_committee_member_path(member), method: :delete, class: "text-red-600 hover:text-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Delete this member?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="px-6 py-8 text-center text-gray-500">No committee members yet. <%= link_to "Add one", new_admin_committee_member_path, class: "text-ocean-700 hover:text-ocean-600 font-medium" %>.</p>
  <% end %>
</div>
