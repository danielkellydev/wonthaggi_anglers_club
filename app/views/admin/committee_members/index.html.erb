<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
  <h1 class="text-2xl font-bold text-charcoal">Committee Members</h1>
  <%= link_to "New Member", new_admin_committee_member_path, class: "inline-flex items-center justify-center px-4 py-2.5 rounded-lg bg-ocean-700 text-white text-sm font-semibold hover:bg-ocean-600 transition-colors min-h-[44px]" %>
</div>

<% if @committee_members.any? %>
  <%# Desktop/tablet table %>
  <div class="hidden md:block bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-xs uppercase tracking-wider text-gray-500">
        <tr>
          <th class="px-6 py-3">Role</th>
          <th class="px-6 py-3">Name</th>
          <th class="px-6 py-3">Phone</th>
          <th class="px-6 py-3">Email</th>
          <th class="px-6 py-3">Position</th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @committee_members.each do |member| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 font-medium"><%= member.role %></td>
            <td class="px-6 py-4"><%= member.name %></td>
            <td class="px-6 py-4 text-gray-500"><%= member.phone %></td>
            <td class="px-6 py-4 text-gray-500"><%= member.email %></td>
            <td class="px-6 py-4 text-gray-500"><%= member.position %></td>
            <td class="px-6 py-4 text-right space-x-3">
              <%= link_to "Edit", edit_admin_committee_member_path(member), class: "text-ocean-700 hover:text-ocean-600 font-medium" %>
              <%= button_to "Delete", admin_committee_member_path(member), method: :delete, class: "text-red-600 hover:text-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Delete this member?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Mobile card list %>
  <div class="md:hidden space-y-3">
    <% @committee_members.each do |member| %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
        <p class="text-xs uppercase tracking-wider text-gray-500"><%= member.role %></p>
        <h2 class="font-semibold text-charcoal mb-2"><%= member.name %></h2>
        <div class="text-sm text-gray-600 space-y-0.5 mb-4">
          <% if member.phone.present? %><p><%= member.phone %></p><% end %>
          <% if member.email.present? %><p class="break-all"><%= member.email %></p><% end %>
        </div>
        <div class="flex items-center gap-2">
          <%= link_to "Edit", edit_admin_committee_member_path(member), class: "flex-1 inline-flex items-center justify-center min-h-[44px] px-4 rounded-lg bg-ocean-50 text-ocean-700 font-semibold text-sm hover:bg-ocean-100 transition-colors" %>
          <%= button_to "Delete", admin_committee_member_path(member), method: :delete, class: "flex-1 inline-flex items-center justify-center min-h-[44px] px-4 rounded-lg bg-red-50 text-red-600 font-semibold text-sm hover:bg-red-100 transition-colors cursor-pointer", form: { class: "flex-1" }, data: { turbo_confirm: "Delete this member?" } %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-100">
    <p class="px-6 py-8 text-center text-gray-500">No committee members yet. <%= link_to "Add one", new_admin_committee_member_path, class: "text-ocean-700 hover:text-ocean-600 font-medium" %>.</p>
  </div>
<% end %>
