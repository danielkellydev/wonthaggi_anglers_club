<%= form_with model: [:admin, post], class: "space-y-6" do |form| %>
  <% if post.errors.any? %>
    <div class="bg-red-50 rounded-lg p-4">
      <p class="text-red-600 font-medium text-sm mb-2"><%= pluralize(post.errors.count, "error") %> prevented this post from being saved:</p>
      <ul class="list-disc list-inside text-sm text-red-500">
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-medium text-charcoal mb-1" %>
    <%= form.text_field :title, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-ocean-600 focus:border-transparent" %>
  </div>

  <div>
    <%= form.label :category, class: "block text-sm font-medium text-charcoal mb-1" %>
    <%= form.select :category, Post::CATEGORIES.map { |c| [c.capitalize, c] }, {}, class: "block w-full rounded-lg border border-gray-300 px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-ocean-600 focus:border-transparent" %>
  </div>

  <div>
    <%= form.label :body, class: "block text-sm font-medium text-charcoal mb-1" %>
    <%= form.rich_text_area :body, class: "min-h-[200px]" %>
  </div>

  <div>
    <%= form.label :featured_image, class: "block text-sm font-medium text-charcoal mb-1" %>
    <% if post.featured_image.attached? %>
      <div class="mb-2">
        <%= image_tag post.featured_image.variant(resize_to_fill: [200, 133]), class: "rounded-lg" %>
      </div>
    <% end %>
    <%= form.file_field :featured_image, accept: "image/jpeg,image/png,image/webp", class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-ocean-50 file:text-ocean-700 hover:file:bg-ocean-100" %>
  </div>

  <div class="flex items-center gap-2">
    <%= form.check_box :published, class: "rounded border-gray-300 text-ocean-600 focus:ring-ocean-500" %>
    <%= form.label :published, "Published", class: "text-sm font-medium text-charcoal" %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit class: "inline-flex items-center px-6 py-2.5 rounded-lg bg-ocean-700 text-white font-semibold hover:bg-ocean-600 transition-colors cursor-pointer" %>
    <%= link_to "Cancel", admin_posts_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>
<% end %>
