<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-charcoal">Events</h1>
  <%= link_to "New Event", new_admin_event_path, class: "inline-flex items-center px-4 py-2 rounded-lg bg-ocean-700 text-white text-sm font-semibold hover:bg-ocean-600 transition-colors" %>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
  <% if @events.any? %>
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-xs uppercase tracking-wider text-gray-500">
        <tr>
          <th class="px-6 py-3">Title</th>
          <th class="px-6 py-3">Date</th>
          <th class="px-6 py-3">Location</th>
          <th class="px-6 py-3">Status</th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @events.each do |event| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 font-medium"><%= event.title %></td>
            <td class="px-6 py-4 text-gray-500"><%= event.starts_at.strftime("%d %b %Y, %l:%M %p") %></td>
            <td class="px-6 py-4 text-gray-500"><%= event.location %></td>
            <td class="px-6 py-4">
              <% if event.published? %>
                <span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800">Published</span>
              <% else %>
                <span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-600">Draft</span>
              <% end %>
            </td>
            <td class="px-6 py-4 text-right space-x-3">
              <%= link_to "Edit", edit_admin_event_path(event), class: "text-ocean-700 hover:text-ocean-600 font-medium" %>
              <%= button_to "Delete", admin_event_path(event), method: :delete, class: "text-red-600 hover:text-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Delete this event?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="px-6 py-8 text-center text-gray-500">No events yet. <%= link_to "Create one", new_admin_event_path, class: "text-ocean-700 hover:text-ocean-600 font-medium" %>.</p>
  <% end %>
</div>
